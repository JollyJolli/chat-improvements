{
  "schemaVersion": 1,
  "id": "chatimprovements",
  "version": "${version}",
  "name": "Chat Improvements",
  "description": "Lightweight client-side Minecraft chat improvements with configurable timestamps.",
  "authors": ["JollyJolli"],
  "environment": "client",
  "entrypoints": {
    "client": ["io.github.jollyjolli.chatimprovements.ChatImprovementsClient"]
  },
  "mixins": [
    {
      "config": "chatimprovements.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*"
  },
  "license": "MIT",
  "contact": {
    "sources": "https://github.com/JollyJolli/chat-improvements",
    "issues": "https://github.com/JollyJolli/chat-improvements/issues"
  }
}
